{
  "name": "flashloan-agent-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "skills", "schemas", ".env.example", "README.md"],
  "bin": {
    "flashloan-agent": "dist/agent-cli.js"
  },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "validate-config": "tsx src/cli.ts validate-config",
    "install-skill": "tsx src/agent-cli.ts install"
  },
  "dependencies": {
    "viem": "^2.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
