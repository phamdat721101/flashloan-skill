{
  "name": "flashloan-agent-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "skills",
    "schemas",
    "crates",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    ".env.example",
    "README.md"
  ],
  "bin": {
    "flashloan-agent": "dist/agent-cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "evidence:spec": "node scripts/verify-flashloan-evidence-spec.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js && cargo test --workspace",
    "validate-config": "tsx src/cli.ts validate-config",
    "sui:validate-config": "tsx src/sui/cli.ts validate-config",
    "sui:wallet-address": "tsx src/sui/cli.ts wallet-address",
    "sui:deploy-guard": "tsx src/sui/cli.ts deploy-guard",
    "sui:upgrade-guard": "tsx src/sui/cli.ts upgrade-guard",
    "sui:deepbook-flashloan-canary": "tsx src/sui/cli.ts deepbook-flashloan-canary",
    "sui:cetus-pool-canary": "tsx src/sui/cli.ts cetus-pool-canary",
    "sui:validate-adapter-registry": "tsx src/sui/cli.ts validate-adapter-registry",
    "install-skill": "tsx src/agent-cli.ts install",
    "rust:check": "cargo check --workspace --locked",
    "rust:test": "cargo test --workspace --locked",
    "liquidity:test": "npm run build && node --test dist/test/liquid-pattern-e2e.test.js dist/test/liquidity-*.test.js dist/test/state-adapters.test.js dist/test/sui-flash-lenders.test.js",
    "liquidity": "tsx src/liquidity/cli.ts",
    "liquidity:benchmark": "npm run build && node dist/liquidity/benchmark.js",
    "liquidity:cetus-reference": "npm run build && node dist/liquidity/cetus-reference.js",
    "liquidity:proof": "npm run build && node dist/liquidity/local-proof.js",
    "l2:test": "npm run build && node --test dist/test/level-2-e2e.test.js",
    "l2": "tsx src/liquidity/cli.ts",
    "l2:proof": "npm run build && node dist/liquidity/l2-proof.js",
    "evm": "tsx src/evm/cli.ts",
    "evm:test": "forge build && npm run build && node --test dist/test/evm-*.test.js",
    "evm:abi-check": "tsx src/evm/abi-check.ts",
    "pretest": "forge build",
    "evm:local-e2e": "npm run build && node scripts/evm-local-e2e.mjs",
    "aero": "tsx src/aero/cli.ts",
    "aero:test": "forge build --quiet && npm run build && node --test dist/test/aero-*.test.js && forge test --match-contract 'AeroSplitExecutor(V2)?Test'",
    "aero:local-e2e": "npm run build && node scripts/aero-local-e2e.mjs",
    "aero:fork-e2e": "npm run build && node scripts/aero-fork-e2e.mjs",
    "aero:v2-local-e2e": "npm run build && node scripts/aero-v2-local-e2e.mjs",
    "evidence:test": "npm run build && node --test dist/test/flashloan-evidence*.test.js",
    "evidence:local-e2e": "forge build --offline && npm run build && node scripts/flashloan-evidence-local-e2e.mjs"
  },
  "dependencies": {
    "@mysten/sui": "^2.0.0",
    "@noble/hashes": "1.8.0",
    "viem": "^2.28.1",
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
