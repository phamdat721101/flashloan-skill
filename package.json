{
  "name": "flashloan-agent-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "skills", "schemas", "crates", "Cargo.toml", "Cargo.lock", "rust-toolchain.toml", ".env.example", "README.md"],
  "bin": {
    "flashloan-agent": "dist/agent-cli.js"
  },
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js && cargo test --workspace",
    "validate-config": "tsx src/cli.ts validate-config",
    "install-skill": "tsx src/agent-cli.ts install",
    "rust:check": "cargo check --workspace --locked",
    "rust:test": "cargo test --workspace --locked"
  },
  "dependencies": {
    "viem": "^2.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
