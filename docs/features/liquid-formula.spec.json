  "architecture": {
    "pattern": "existing TypeScript adapters with protocol-specific bigint math and bounded worker execution",
    "isolation_boundaries": "canonical snapshots vs projected math; Q96 vs X64; analysis vs admission/signing; SDK reference outside runtime",
    "execution_flow": [
      "coherent source capture -> validated v4 pool envelopes",
      "inspect or projection bound to state digest and logical operation identity",
      "bounded exact route sampling -> honest optimum status",
      "selected amount re-quote -> canonical candidate -> existing simulation/admission runtime",
      "independent effects and live receipts required before production admission"
    ]
  },
  "data_contracts": {
    "inputs": {
      "schema": "schemas/liquidity-analytics.schema.json",
      "versions": "new 4.0 analytics; existing v3 remains unchanged",
      "operations": [
        "inspect",
        "project",
        "size",
        "target-price",
        "snapshot-analytics-arbitrum"
      ]
    },
    "outputs": {
      "projection": "native output/fees and immutable projected state digest",
      "sizing": "best-found or exhaustive-domain certificate",
      "execution": "existing RouteCandidate subject to independent admission; no send from analytics CLI"
    },
    "error_states": [
      "SNAPSHOT_DIGEST_MISMATCH",
      "OPERATION_ALREADY_APPLIED",
      "CLMM_COVERAGE_EXHAUSTED",
      "CETUS_COVERAGE_EXHAUSTED",
      "ANALYTICS_CANDIDATE_QUOTE_MISMATCH",
      "ANALYTICS_TIMEOUT",
      "UNSUPPORTED_MATH_ADAPTER"
    ]
  },
  "test_criteria": [
    "10,000 V2 adjusted-balance invariant/maximal-output vectors",
    "10,000 independent Cetus SDK vectors with complete and coverage-exhausted cases",
    "schema-valid public examples/results and legacy v3 compatibility",
    "both source and compiled worker/CLI paths, timeout and cancellation",
    "common-head capture rejects code/hash drift and bounds RPC fan-out",
    "small-domain exhaustive profit equivalence and truthful sampled optimality",
    "projected/tampered sizing cannot bypass simulation or execution admission",
    "live production admission requires independent per-adapter receipts; current global map remains non-Done"
  ]
}
