  "architecture": {
    "pattern": "Strict JSON CLI; MCP research client; per-network native adapters; owner journal",
    "isolation_boundaries": "Finance journal, grants (openx/finance/approval/1) and budget isolated from flashloan and prediction; enabled/live default false; MCP never signs",
    "execution_flow": [
      "strictParse + Ajv + semantic rules",
      "import research Plan (planHash)",
      "simulate: admit payload, fresh fee/nonce, LocalPlan hash, exact native simulation",
      "owner Ed25519 grant recorded, nonce reserved",
      "execute: lease, admitNewAction, re-simulate, sign-only, validate artifact, durable SUBMITTING, submit",
      "reconcile by known hash; MISMATCH halts"
    ]
  },
  "data_contracts": {
    "inputs": {
      "schema": "schemas/finance-v1.schema.json",
      "request": "finance.request/1",
      "local": "finance.local-request/1",
      "authority": "finance.approval/1",
      "units": "atomic base-unit strings; XRPL issued coefficient/exponent; XRP drops"
    },
    "outputs": {
      "response": "finance.response/1",
      "local": "finance.local-result/1"
    }
  },
  "test_criteria": [
    "EDGE-01 boundary: disabled path, raw input faults, MCP auth/escalation, R4 handoff",
    "EDGE-02 state: pinned reads, reorg/mixed ledger, code drift, XLS-66 units",
    "EDGE-03 authority: grant binding, replay, lease, live gate",
    "EDGE-04 native: approve+repay, tamper rejection, R3 protect, XRPL Payment sign-only",
    "EDGE-05 recovery: UNKNOWN by known hash, restart, mismatch halt, torn journal",
    "Forge FinanceProtectionAccountTest 8 cases"
  ]
