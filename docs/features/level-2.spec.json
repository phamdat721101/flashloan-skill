  "architecture": {
    "pattern": "versioned observations, incremental hash-linked journals, canonical state generations, exact quote-based features, chronological research models and existing chain-local execution admission",
    "isolation_boundaries": "External/provisional observations cannot mutate canonical chain state; agent resources cannot authorize signing; research scores cannot bypass simulation or risk gates.",
    "execution_flow": [
      "validate source identity, parentage, units and arrival time",
      "journal evidence before consumer acknowledgement",
      "build deterministic coherent features and agent resources",
      "evaluate temporal holdouts and independently paired shadow outcomes",
      "bind context to exact canonical route, refresh risk before signing and submission",
      "reconcile existing authoritative receipts; deduplicate risk credit by lane and receipt digest"
    ]
  },
  "data_contracts": {
    "inputs": {
      "observation": "MarketObservation 1.0 with source/generation/cursor/parent/finality/availability and bounded typed payload",
      "pool": "Existing PoolStateEnvelope 4.0; complete DeepBook book or pinned Cetus BCS event profile",
      "research": "Frame-bound ForwardOutcome with exact future price and separate shadow-runtime net evidence"
    },
    "outputs": {
      "context": "MicrostructureFrame 1.0 with rational depth/flow features, coverage reasons and source watermarks",
      "prediction": "Research-only PredictionRecord until an operator-pinned EvaluationReport admits it",
      "execution": "Existing LiquidityDecision, receipt accounting and persistent risk reflection"
    },
    "error_states": [
      "L2_SOURCE_GAP",
      "L2_PARENT_DIVERGENCE",
      "L2_INVALIDATED_GENERATION",
      "L2_STALE_STATE",
      "L2_OUTCOME_HORIZON_MISMATCH",
      "L2_INVALID_OR_LEAKING_MODEL",
      "L2_UNADMITTED_PREDICTION",
      "L2_RISK_RESIZING_OR_RECONCILIATION_REQUIRED",
      "L2_RECEIPT_SUBSTITUTION"
    ]
  },
  "test_criteria": [
    "five EDGE local proofs pass with structured markers",
    "journal corruption, restart, cross-writer tails and generation invalidation are explicit",
    "V2 independent invariant, V3 Q96, Cetus X64, DeepBook fees and incomplete coverage remain distinct",
    "real MCP stdio subprocess negotiates capabilities and validates requests",
    "calibration availability, purged folds and holdout-only data cannot leak",
    "synthetic positive admission tests do not constitute market-alpha evidence",
    "reflection changes during final RPC block signing; duplicate receipts cannot restore size",
    "production admission stays disabled without independent operator, source and live receipt proof"
  ]
}
