  "architecture": {
    "pattern": "Versioned Aero adapters around shared integer projection, bounded cyclic allocation and authenticated portable execution",
    "isolation_boundaries": "Base only; proposal schemas distinct from analytics 4.0; new executor revision required; docs verified separately from unimplemented Aero E2E",
    "execution_flow": [
      "pin generation, block, factory, implementation and fee dependencies",
      "project complete cycles sequentially with exact native-unit math",
      "allocate and size within deterministic bounded domain",
      "bind typed new artifact capability and simulate complete flashloan",
      "refresh head and fees before future signing; reconcile receipt and custody"
    ]
  },
