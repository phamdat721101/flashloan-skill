  "errata": [
    {
      "id": "E1",
      "finding": "Timestamp uses format date-time; repo has no ajv-formats and strict Ajv throws unknown format",
      "resolution": "Loader registers date-time as RFC3339 UTC regex; no new dependency"
    },
    {
      "id": "E2",
      "finding": "6 strictTypes violations (Asset if/then/else assetId; CandidateResultV2 snapshot/researchPlan/researchPlans allOf)",
      "resolution": "Own Ajv instance with strictTypes:false; bytes unchanged because HyperMove pins the SHA; fix in a coordinated v1.1"
    },
    {
      "id": "E3",
      "finding": "reasonCode/reasonCodes are free strings; no closed registry",
      "resolution": "Closed REASON_CODES registry in src/evidence/integration.ts enforced by the semantic validator"
    },
    {
      "id": "E4",
      "finding": "Uint regex admits 2^256 (78 digits)",
      "resolution": "Semantic validator reuses uint() from src/liquidity/state.ts (INTEGER_OUT_OF_RANGE)"
    },
    {
      "id": "E5",
      "finding": "Legacy digest() accepts unsafe integers, floats and lone surrogates",
      "resolution": "domainHash adds the guards; digest() unchanged for legacy hashes"
    },
    {
      "id": "E6",
      "finding": "v6 FlashloanVersions schema is closed (additionalProperties:false) and vendor-pinned, so v7 keys cannot be added to config/flashloan-versions.json",
      "resolution": "Sibling config/flashloan-integration-versions.json binds the base manifest, prompt v7, contract and admission-producer list by sha256; gate features.integrationV7 defaults false"
    }
  ],
