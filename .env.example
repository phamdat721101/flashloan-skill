# Required for autonomous execution. Do not commit a real key.
OPERATOR_PRIVATE_KEY=
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
FLASH_EXECUTOR_ADDRESS=
PRIVATE_RELAY_URL=
TREASURY_ADDRESS=

# Required only by `flashloan-scan deploy-multi`; do not substitute guessed addresses.
AAVE_PROVIDER=
UNISWAP_V2_FACTORY=
UNISWAP_V3_FACTORY=
UNISWAP_V4_POOL_MANAGER=
ALLOW_MULTI_VENUE_DEPLOY=false

# Defaults are used if omitted. All currency values are USD.
BORROW_TIERS_USD=100000,200000,500000
MAX_GAS_USD=2000
MAX_DAILY_LOSS_USD=10000
MAX_PRICE_IMPACT_BPS=200
MIN_NET_PROFIT_USD=10

# Sui terminal-profit guard. Mainnet is canary-only and requires a second confirmation.
# Set SUI_DEPLOYER_ADDRESS to the configured local wallet address before running
# `npm run sui:deploy-guard`.
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_EXECUTION_MODE=read-only # read-only | dry-run | testnet-canary | mainnet-canary | auto
SUI_GUARD_PACKAGE_DIR=move/terminal-profit-guard
SUI_GAS_BUDGET_MIST=100000000
SUI_DEPLOYER_ADDRESS=
SUI_DEPLOY_CONFIRM= # must equal publish to create a new package, or upgrade to update the reviewed package below
# Required only for SUI_NETWORK=mainnet. Obtain and review the value with
# `sui client chain-identifier`; do not copy a hard-coded identifier.
SUI_CHAIN_IDENTIFIER=
SUI_MAINNET_DEPLOY_CONFIRM= # must equal I_UNDERSTAND_MAINNET_DEPLOYMENT
# Required only for an upgrade. Use the current package held by UpgradeCap, not
# an earlier package version. These are public object identifiers, not secrets.
SUI_GUARD_PACKAGE_ID=
SUI_GUARD_UPGRADE_CAP_ID=
# Runtime route compilation uses the active (possibly upgraded) package and these
# operator-controlled capabilities. They are public identifiers, never signing keys.
SUI_GUARD_ACTIVE_PACKAGE_ID=
SUI_GUARD_ADMIN_CAP_ID=
SUI_GUARD_OPERATOR_CAP_ID=
SUI_GUARD_PAUSE_CAP_ID=

# Used only by signed Sui utility paths, never serialized or committed.
# Use a Bech32 secret beginning with suiprivkey. Do not commit a real key.
SUI_OPERATOR_PRIVATE_KEY=

# Autonomous multi-lender execution. The registry is public, revision-pinned, and must
# remain disabled until each NAVI/Suilend/Scallop and Cetus/Turbos interface is verified.
# In auto mode, SUI is the only operator-owned fungible input; every route fee must come
# from a borrowed or route-produced asset in the same PTB.
SUI_ADAPTER_REGISTRY=
SUI_MAX_BORROW_BASE=
SUI_MIN_PROFIT_BASE=
SUI_MAX_GAS_BUDGET_MIST=

# DeepBook V3 hot-potato lender canary. This command only simulates borrow -> exact
# repay and never signs or submits. Package/pool identifiers must be reviewed against
# the official DeepBook contract-information page; the digest and checkpoint must come
# from one freshly captured gRPC snapshot.
SUI_DEEPBOOK_PACKAGE_ID=
SUI_DEEPBOOK_PACKAGE_DIGEST=
SUI_DEEPBOOK_VERIFIED_CHECKPOINT=
SUI_DEEPBOOK_POOL_TYPE_ORIGIN=
SUI_DEEPBOOK_POOL_ID=
SUI_DEEPBOOK_BASE_ASSET_TYPE=
SUI_DEEPBOOK_QUOTE_ASSET_TYPE=
SUI_DEEPBOOK_BORROW_AMOUNT=

# Cetus CLMM venue canary. These public pins must describe an active pool whose
# asset types exactly match the selected DeepBook lender pool.
SUI_CETUS_PACKAGE_ID=
SUI_CETUS_PACKAGE_DIGEST=
SUI_CETUS_VERIFIED_CHECKPOINT=
SUI_CETUS_GLOBAL_CONFIG_ID=
SUI_CETUS_POOL_ID=
SUI_CETUS_COIN_A_TYPE=
SUI_CETUS_COIN_B_TYPE=
SUI_CETUS_FEE_RATE=

# Optional Level 2 market WebSocket endpoints. Source JSON names these variables;
# credentials embedded in a provider endpoint never enter evidence or stdout.
# Native streaming needs Node 22+; offline/RPC/replay/MCP retain Node 20 support.
L2_FAST_FEED_URL=
L2_HYPERLIQUID_URL=wss://api.hyperliquid.xyz/ws
L2_BINANCE_STREAM_URL=
L2_BINANCE_SNAPSHOT_URL=

# Shared EVM pipeline. Select chain through a versioned manifest/config.
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional independent submission endpoints; defaults to the same public RPC.
# Public submission gives no MEV privacy guarantee.
BASE_SUBMISSION_URL=
ROBINHOOD_SUBMISSION_URL=

# Dynamic pool universe / MultiVenue executor (Arbitrum)
# FLASH_EXECUTOR_ADDRESS must expose executeDexPairArbitrage (flashloan-scan arb fails fast otherwise).
# Pool-address executor used by `node dist/evm/cli.js universe-probe` when --executor is omitted.
MULTI_VENUE_EXECUTOR_ADDRESS=
# Opt-in dynamic mode for flashloan-scan signal/arb (fails closed when the universe expires).
# UNIVERSE_PATH=.nim/universe/arbitrum.json
# ASSET_POLICY_PATH=config/arbitrum-asset-policy.json
# MAX_PAIRS=16
# Optional separate submission endpoint for `evm deploy` (defaults to ARBITRUM_RPC_URL).
# ARBITRUM_SUBMISSION_URL=
