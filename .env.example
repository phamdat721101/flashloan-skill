# Required for autonomous execution. Do not commit a real key.
OPERATOR_PRIVATE_KEY=
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
FLASH_EXECUTOR_ADDRESS=
PRIVATE_RELAY_URL=
TREASURY_ADDRESS=

# Required only by `flashloan-scan deploy-multi`; do not substitute guessed addresses.
AAVE_PROVIDER=
UNISWAP_V2_FACTORY=
UNISWAP_V3_FACTORY=
UNISWAP_V4_POOL_MANAGER=
ALLOW_MULTI_VENUE_DEPLOY=false

# Defaults are used if omitted. All currency values are USD.
BORROW_TIERS_USD=100000,200000,500000
MAX_GAS_USD=2000
MAX_DAILY_LOSS_USD=10000
MAX_PRICE_IMPACT_BPS=200
MIN_NET_PROFIT_USD=1

# Sui terminal-profit guard. Mainnet is canary-only and requires a second confirmation.
# The Sui CLI wallet remains outside this repository; set its active address to
# SUI_DEPLOYER_ADDRESS before running `npm run sui:deploy-guard`.
SUI_NETWORK=testnet
SUI_RPC_URL=https://fullnode.testnet.sui.io:443
SUI_EXECUTION_MODE=read-only # read-only | dry-run | testnet-canary | mainnet-canary
SUI_GUARD_PACKAGE_DIR=move/terminal-profit-guard
SUI_GAS_BUDGET_MIST=100000000
SUI_DEPLOYER_ADDRESS=
SUI_DEPLOY_CONFIRM= # must equal publish to submit a deployment
# Required only for SUI_NETWORK=mainnet. Obtain and review the value with
# `sui client chain-identifier`; do not copy a hard-coded identifier.
SUI_CHAIN_IDENTIFIER=
SUI_MAINNET_DEPLOY_CONFIRM= # must equal I_UNDERSTAND_MAINNET_DEPLOYMENT

# Used only by signed Sui utility paths, never by the Sui CLI publish command.
# Use a Bech32 secret beginning with suiprivkey. Do not commit a real key.
SUI_OPERATOR_PRIVATE_KEY=
