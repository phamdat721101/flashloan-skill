# Required for autonomous execution. Do not commit a real key.
OPERATOR_PRIVATE_KEY=
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
FLASH_EXECUTOR_ADDRESS=
PRIVATE_RELAY_URL=
TREASURY_ADDRESS=

# Required only by `flashloan-scan deploy-multi`; do not substitute guessed addresses.
AAVE_PROVIDER=
UNISWAP_V2_FACTORY=
UNISWAP_V3_FACTORY=
UNISWAP_V4_POOL_MANAGER=
ALLOW_MULTI_VENUE_DEPLOY=false

# Defaults are used if omitted. All currency values are USD.
BORROW_TIERS_USD=100000,200000,500000
MAX_GAS_USD=2000
MAX_DAILY_LOSS_USD=10000
MAX_PRICE_IMPACT_BPS=200
MIN_NET_PROFIT_USD=1
