{
  "harness": {
    "errorHandler": {
      "retries": 2,
      "backoff": "exp-jitter"
    },
    "enforcer": {
      "strategies": [
        "nonempty"
      ],
      "mode": "strict",
      "maxHeals": 0
    },
    "memory": {
      "verifyCache": true,
      "priors": true,
      "store": ".nim/memory.jsonl",
      "sessionStore": ".nim/sessions.jsonl"
    },
    "lessons": {
      "store": ".nim/lessons.jsonl"
    },
    "context": {
      "progressive": true,
      "maxInputTokens": 8000,
      "onExceed": "compact"
    },
    "logCompact": {
      "strategy": "errors-only",
      "maxLines": 100,
      "escalateOnEmpty": true,
      "artifactDir": ".nim/log-artifacts"
    },
    "search": {
      "topK": 3
    },
    "knowledge": {
      "root": ".nim-memory",
      "projectId": "rollover-skill",
      "captureEpisodes": true
    },
    "cache": {
      "provider": "openai",
      "strategy": "prefix",
      "minTokens": 1024,
      "roi": true
    }
  },
  "workspace": {
    "stack": [
      "typescript",
      "rust",
      "web3"
    ],
    "livenessFile": "docs/state/active_session.md",
    "mode": "warn",
    "deliver": {
      "mode": "strict",
      "briefDir": "docs/features",
      "requireWorkrule": true,
      "profiles": {
        "default": {
          "contract": ".nim/deliver/default-contract.json",
          "configFiles": [],
          "commands": [
            "npm test",
            "npm run typecheck"
          ]
        },
        "liquid-formula-local": {
          "contract": ".nim/deliver/liquid-formula-local-contract.json",
          "configFiles": [],
          "commands": [
            "npm run typecheck",
            "npm run liquidity:test",
            "nim-skill search compile --title \"Liquidity formula local implementation\" --spec docs/features/liquid-formula.spec.json"
          ]
        },
        "level-2-local": {
          "contract": ".nim/deliver/level-2-local-contract.json",
          "configFiles": [],
          "commands": [
            "npm run typecheck",
            "npm run l2:test",
            "nim-skill search compile --title \"Level 2 market context implementation\" --spec docs/features/level-2.spec.json"
          ]
        },
        "evm-local": {
          "contract": ".nim/deliver/evm-contract.json",
          "configFiles": [
            "config/base-mainnet.json",
            "config/robinhood-mainnet.json"
          ],
          "commands": [
            "npm run typecheck",
            "npm run evm:test",
            "nim-skill search compile --title \"Base and Robinhood flashloan implementation\" --spec docs/features/evm-flashloan.spec.json"
          ]
        },
        "robinhood-native-v4": {
          "contract": ".nim/deliver/robinhood-native-v4-contract.json",
          "configFiles": [
            "config/robinhood-mainnet.json"
          ],
          "commands": [
            "npm run build",
            "npm run evm:abi-check",
            "forge test --match-path test/NativeV4FlashExecutor.t.sol"
          ]
        }
      }
    }
  },
  "workrule": {
    "logFile": ".nim/agent-support-log.md"
  },
  "hooks": {
    "enabled": true,
    "profile": "default",
    "memoryFiles": [
      ".nim/agent-support-log.md",
      ".nim/lessons.jsonl"
    ],
    "search": {
      "topK": 3,
      "maxTokens": 1500
    },
    "auditor": {
      "enabled": true,
      "threshold": 4,
      "mode": "strict",
      "store": ".nim/auditor"
    }
  }
}
