{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "roots",
    "contracts",
    "exclusions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "chainId": {
      "enum": [
        42161,
        8453,
        4663
      ]
    },
    "roots": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "address",
          "codeHash",
          "source"
        ],
        "properties": {
          "role": {
            "enum": [
              "morpho",
              "balancer-v2",
              "aave-provider",
              "v2-factory",
              "v3-factory",
              "v4-manager",
              "aero-factory",
              "aero-pool"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "codeHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 6
          },
          "implementation": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "implementationCodeHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "maxFee": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "aero-factory"
                }
              }
            },
            "then": {
              "required": [
                "generation"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "generation"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "aero-pool"
                }
              }
            },
            "then": {
              "required": [
                "implementation",
                "implementationCodeHash"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "implementation"
                    ]
                  },
                  {
                    "required": [
                      "implementationCodeHash"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "role": {
                  "const": "balancer-v2"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "maxFee"
                ]
              }
            }
          }
        ]
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MultiVenueArbitrageExecutor",
          "PortableMultiSplitFlashExecutor",
          "V4StateQuoter",
          "ImmutableArbitrageExecutor",
          "AeroSplitFlashExecutor"
        ]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "reason"
        ],
        "properties": {
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contracts": {
            "contains": {
              "const": "AeroSplitFlashExecutor"
            }
          }
        }
      },
      "then": {
        "properties": {
          "chainId": {
            "const": 8453
          },
          "contracts": {
            "maxItems": 1
          },
          "roots": {
            "items": {
              "properties": {
                "role": {
                  "enum": [
                    "morpho",
                    "balancer-v2",
                    "aero-factory",
                    "aero-pool"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "role": {
                        "const": "balancer-v2"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "maxFee"
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "roots": {
            "items": {
              "properties": {
                "role": {
                  "enum": [
                    "morpho",
                    "balancer-v2",
                    "aave-provider",
                    "v2-factory",
                    "v3-factory",
                    "v4-manager"
                  ]
                }
              },
              "not": {
                "required": [
                  "maxFee"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
