{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "chainId",
    "roots",
    "contracts",
    "exclusions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "chainId": {
      "enum": [
        42161,
        8453,
        4663
      ]
    },
    "roots": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "address",
          "codeHash",
          "source"
        ],
        "properties": {
          "role": {
            "enum": [
              "morpho",
              "balancer-v2",
              "aave-provider",
              "v2-factory",
              "v3-factory",
              "v4-manager"
            ]
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "codeHash": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "source": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "MultiVenueArbitrageExecutor",
          "PortableMultiSplitFlashExecutor",
          "V4StateQuoter",
          "ImmutableArbitrageExecutor"
        ]
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "reason"
        ],
        "properties": {
          "contract": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
