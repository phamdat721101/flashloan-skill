{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Arbitrum Scan Envelope",
  "type": "object",
  "required": ["schemaVersion", "runId", "chainId", "observedBlock", "opportunities", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "runId": { "type": "string", "minLength": 1 },
    "chainId": { "const": 42161 },
    "observedBlock": { "type": "object", "required": ["number", "hash", "timestamp"], "properties": { "number": { "type": "string", "pattern": "^[0-9]+$" }, "hash": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }, "timestamp": { "type": "string", "format": "date-time" } } },
    "opportunities": { "type": "array", "items": { "$ref": "#/$defs/opportunity" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
  },
  "$defs": {
    "opportunity": {
      "type": "object",
      "required": ["id", "protocol", "kind", "status", "observedBlock", "observedAt", "expiresAt", "target", "metrics", "executionIntent", "candidate"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "protocol": { "enum": ["aave-v3", "morpho-blue", "balancer-v2", "uniswap-v2", "uniswap-v3", "uniswap-v4"] },
        "kind": { "enum": ["liquidation-watch", "flash-liquidity", "pool-liquidity", "arbitrage-pool"] },
        "status": { "enum": ["observed", "validated", "actionable"] },
        "observedBlock": { "type": "string", "pattern": "^[0-9]+$" },
        "observedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "target": { "type": "object", "additionalProperties": { "type": "string" } },
        "metrics": { "type": "object", "additionalProperties": { "type": "string" } },
        "executionIntent": { "type": "object", "required": ["kind", "contract", "metadata"], "properties": { "kind": { "enum": ["aave-v3-liquidation", "morpho-blue-liquidation", "balancer-v2-flash-loan", "uniswap-v2-arbitrage", "uniswap-v3-arbitrage", "uniswap-v4-unlock"] }, "contract": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" }, "metadata": { "type": "object" } } },
        "candidate": {
          "oneOf": [
            { "type": "object", "required": ["protocol", "borrower", "pool", "reserves", "healthFactorWad", "totalDebtBase", "totalCollateralBase"], "properties": { "protocol": { "const": "aave-v3" }, "borrower": { "$ref": "#/$defs/address" }, "pool": { "$ref": "#/$defs/address" }, "reserves": { "type": "array", "items": { "$ref": "#/$defs/address" } }, "healthFactorWad": { "type": "string", "pattern": "^[0-9]+$" }, "totalDebtBase": { "type": "string", "pattern": "^[0-9]+$" }, "totalCollateralBase": { "type": "string", "pattern": "^[0-9]+$" } } },
            { "type": "object", "required": ["protocol", "borrower", "blue", "marketId", "loanToken", "collateralToken", "oracle", "irm", "lltv", "borrowShares", "borrowedAssets", "collateral"], "properties": { "protocol": { "const": "morpho-blue" }, "borrower": { "$ref": "#/$defs/address" }, "blue": { "$ref": "#/$defs/address" }, "marketId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }, "loanToken": { "$ref": "#/$defs/address" }, "collateralToken": { "$ref": "#/$defs/address" }, "oracle": { "$ref": "#/$defs/address" }, "irm": { "$ref": "#/$defs/address" }, "lltv": { "type": "string", "pattern": "^[0-9]+$" }, "borrowShares": { "type": "string", "pattern": "^[0-9]+$" }, "borrowedAssets": { "type": "string", "pattern": "^[0-9]+$" }, "collateral": { "type": "string", "pattern": "^[0-9]+$" } } },
            { "type": "object", "required": ["protocol", "vault", "poolId", "callbackRequired", "broadcastEligible"], "properties": { "protocol": { "const": "balancer-v2" }, "vault": { "$ref": "#/$defs/address" }, "poolId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }, "callbackRequired": { "const": true }, "broadcastEligible": { "const": false } } },
            { "type": "object", "required": ["protocol", "factory", "pool", "token0", "token1", "broadcastEligible"], "properties": { "protocol": { "const": "uniswap-v2" }, "factory": { "$ref": "#/$defs/address" }, "pool": { "$ref": "#/$defs/address" }, "token0": { "$ref": "#/$defs/address" }, "token1": { "$ref": "#/$defs/address" }, "broadcastEligible": { "const": false } } },
            { "type": "object", "required": ["protocol", "factory", "pool", "token0", "token1", "fee", "tickSpacing", "broadcastEligible"], "properties": { "protocol": { "const": "uniswap-v3" }, "factory": { "$ref": "#/$defs/address" }, "pool": { "$ref": "#/$defs/address" }, "token0": { "$ref": "#/$defs/address" }, "token1": { "$ref": "#/$defs/address" }, "fee": { "type": "integer", "minimum": 0 }, "tickSpacing": { "type": "integer" }, "broadcastEligible": { "const": false } } },
            { "type": "object", "required": ["protocol", "poolManager", "poolId", "currency0", "currency1", "hooks", "callbackRequired", "broadcastEligible"], "properties": { "protocol": { "const": "uniswap-v4" }, "poolManager": { "$ref": "#/$defs/address" }, "poolId": { "type": "string", "pattern": "^0x[0-9a-fA-F]{64}$" }, "currency0": { "$ref": "#/$defs/address" }, "currency1": { "$ref": "#/$defs/address" }, "hooks": { "$ref": "#/$defs/address" }, "callbackRequired": { "const": true }, "broadcastEligible": { "const": false } } }
          ]
        }
      }
    },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "diagnostic": { "type": "object", "required": ["stage", "code", "message", "retryable"], "properties": { "protocol": { "enum": ["aave-v3", "morpho-blue", "balancer-v2", "uniswap-v2", "uniswap-v3", "uniswap-v4"] }, "stage": { "enum": ["config", "checkpoint", "logs", "state", "output"] }, "code": { "enum": ["RPC_TRANSIENT", "RPC_PERMANENT", "INVALID_DATA", "REORG_DETECTED"] }, "message": { "type": "string" }, "retryable": { "type": "boolean" } } }
  }
}
