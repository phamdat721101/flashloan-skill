{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillConfig",
  "type": "object",
  "required": ["chainId", "rpcUrl", "risk"],
  "properties": {
    "chainId": { "type": "integer", "minimum": 1 },
    "rpcUrl": { "type": "string", "format": "uri" },
    "executorAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "treasuryAddress": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "risk": { "$ref": "#/$defs/risk" }
  },
  "$defs": {
    "risk": {
      "type": "object",
      "required": ["borrowTiersUsd", "maxGasUsd", "maxDailyLossUsd", "maxPriceImpactBps", "minNetProfitUsd"],
      "properties": {
        "borrowTiersUsd": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
        "maxGasUsd": { "type": "number", "exclusiveMinimum": 0 },
        "maxDailyLossUsd": { "type": "number", "exclusiveMinimum": 0 },
        "maxPriceImpactBps": { "type": "number", "exclusiveMinimum": 0 },
        "minNetProfitUsd": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
