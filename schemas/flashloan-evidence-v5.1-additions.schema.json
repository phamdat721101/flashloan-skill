    "ArtifactIntegrity": {
      "allOf": [
        {
          "$ref": "#/$defs/Header"
        },
        {
          "if": {
            "properties": {
              "evidenceClass": {
                "const": "RECEIPT"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "artifacts": {
                "type": "array",
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "receipt"
                    },
                    "parse": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "kind",
                    "parse"
                  ],
                  "type": "object"
                }
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "evidenceClass": {
                "const": "NATIVE_SIM"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "artifacts": {
                "type": "array",
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "native-simulation"
                    },
                    "parse": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "kind",
                    "parse"
                  ],
                  "type": "object"
                }
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "evidenceClass": {
                "const": "SNAPSHOT_MODEL"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "artifacts": {
                "type": "array",
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "canonical-state"
                    },
                    "parse": {
                      "const": "ok"
                    }
                  },
                  "required": [
                    "kind",
                    "parse"
                  ],
                  "type": "object"
                }
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "flags": {
                "type": "array",
                "contains": {
                  "enum": [
                    "EMPTY_ARTIFACT",
                    "UNDECLARED_REUSE",
                    "PARAMETRIC_SUSPECT",
                    "SCHEMA_INVALID_ARTIFACT"
                  ]
                }
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "verdict": {
                "const": "BLOCK"
              }
            },
            "type": "object"
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "schemaVersion": true,
        "runId": true,
        "recordType": {
          "const": "artifact-integrity"
        },
        "roundId": {
          "$ref": "#/$defs/Id"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Artifact"
          },
          "minItems": 1,
          "maxItems": 512
        },
        "stateInvariance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "comparedRunId": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Id"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stateDigestChanged": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "economicResultChanged": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "verdict": {
              "enum": [
                "STATE_DEPENDENT",
                "PARAMETRIC_SUSPECT",
                "NOT_COMPARABLE"
              ]
            }
          },
          "required": [
            "comparedRunId",
            "stateDigestChanged",
            "economicResultChanged",
            "verdict"
          ]
        },
        "evidenceClass": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "enum": [
              "EMPTY_ARTIFACT",
              "INVALID_JSON",
              "SCHEMA_INVALID_ARTIFACT",
              "UNDECLARED_REUSE",
              "PARAMETRIC_SUSPECT",
              "MISSING_NATIVE_PAYLOAD",
              "UNUSED_PRINCIPAL_AS_LOSS",
              "SELF_DECLARED_CLASS_MISMATCH",
              "VALUE_UNCHANGED_ACROSS_STATES",
              "LINEAGE_MISMATCH",
              "ECONOMIC_INVARIANT_FAILED"
            ]
          }
        },
        "verdict": {
          "enum": [
            "PASS",
            "BLOCK"
          ]
        }
      },
      "required": [
        "recordType",
        "roundId",
        "artifacts",
        "stateInvariance",
        "evidenceClass",
        "flags",
        "verdict"
      ]
