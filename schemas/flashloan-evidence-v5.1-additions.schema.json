{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flashloan:contracts:5.1-additions",
  "title": "Flashloan evidence v5.1 additive records (R17-R22)",
  "$comment": "Proposed contract. Reuses urn:flashloan:contracts:5.0 primitives by reference; does not reinterpret any v5 record. StageEvent/Report changes are additive patches listed in the PRD.",
  "oneOf": [
    {
      "$ref": "#/$defs/LiquidityPattern"
    },
    {
      "$ref": "#/$defs/EntryBand"
    },
    {
      "$ref": "#/$defs/TriggerObservation"
    },
    {
      "$ref": "#/$defs/LegAttribution"
    },
    {
      "$ref": "#/$defs/ArtifactIntegrity"
    },
    {
      "$ref": "#/$defs/LessonCheck"
    },
    {
      "$ref": "#/$defs/RecallApplication"
    },
    {
      "$ref": "#/$defs/Readiness"
    },
    {
      "$ref": "#/$defs/RoundRow"
    },
    {
      "$ref": "#/$defs/TriggerSurvival"
    }
  ],
  "$defs": {
    "Raw": {
      "$ref": "urn:flashloan:contracts:5.0#/$defs/Raw"
    },
    "SignedRaw": {
      "$ref": "urn:flashloan:contracts:5.0#/$defs/SignedRaw"
    },
    "Hash": {
      "$ref": "urn:flashloan:contracts:5.0#/$defs/Hash"
    },
    "Ratio": {
      "$ref": "urn:flashloan:contracts:5.0#/$defs/Ratio"
    },
    "Asset": {
      "$ref": "urn:flashloan:contracts:5.0#/$defs/Asset"
    },
    "StateIdentity": {
      "$ref": "urn:flashloan:contracts:5.0#/$defs/StateIdentity"
    },
    "EvidenceRef": {
      "$ref": "urn:flashloan:contracts:5.0#/$defs/EvidenceRef"
    },
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "Reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 512
    },
    "Count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "EvidenceClass": {
      "enum": [
        "RECEIPT",
        "NATIVE_SIM",
        "SNAPSHOT_MODEL",
        "PARAMETRIC"
      ]
    },
    "TriggerDirection": {
      "enum": [
        "sell-base",
        "buy-base"
      ]
    },
    "Header": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "5.1"
        },
        "runId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "schemaVersion",
        "runId"
      ]
    },
    "DepthBand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bps": {
          "enum": [
            10,
            25,
            50,
            100,
            200,
            500
          ]
        },
        "side": {
          "enum": [
            "bid",
            "ask"
          ]
        },
        "inputRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        }
      },
      "required": [
        "bps",
        "side",
        "inputRaw",
        "reason"
      ],
      "if": {
        "properties": {
          "inputRaw": {
            "type": "null"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "type": "object"
      }
    },
    "PatternPool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "poolId": {
          "$ref": "#/$defs/Id"
        },
        "feePips": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "spotPrice": {
          "$ref": "#/$defs/Ratio"
        },
        "activeLiquidityRaw": {
          "$ref": "#/$defs/Raw"
        },
        "depth": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DepthBand"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lowerTick": {
              "type": "integer"
            },
            "upperTick": {
              "type": "integer"
            },
            "complete": {
              "type": "boolean"
            }
          },
          "required": [
            "lowerTick",
            "upperTick",
            "complete"
          ]
        }
      },
      "required": [
        "poolId",
        "feePips",
        "spotPrice",
        "activeLiquidityRaw",
        "depth",
        "coverage"
      ]
    },
    "LiquidityPattern": {
      "allOf": [
        {
          "$ref": "#/$defs/Header"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "schemaVersion": true,
        "runId": true,
        "recordType": {
          "const": "liquidity-pattern"
        },
        "state": {
          "$ref": "#/$defs/StateIdentity"
        },
        "stateDigest": {
          "$ref": "#/$defs/Hash"
        },
        "pairAssets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PatternPool"
          },
          "minItems": 2,
          "maxItems": 16
        },
        "referenceBandBps": {
          "enum": [
            10,
            25,
            50,
            100,
            200,
            500
          ]
        },
        "deepPoolId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "thinPoolId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "depthRatio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ]
        },
        "pattern": {
          "enum": [
            "DEEP_LOW_FEE",
            "DEEP_HIGH_FEE",
            "BALANCED",
            "UNRESOLVED"
          ]
        },
        "restingGap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "spotGapBps": {
              "$ref": "#/$defs/Ratio"
            },
            "roundTripFeeBps": {
              "$ref": "#/$defs/Ratio"
            },
            "netAtRestBps": {
              "$ref": "#/$defs/Ratio"
            }
          },
          "required": [
            "spotGapBps",
            "roundTripFeeBps",
            "netAtRestBps"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "recordType",
        "state",
        "stateDigest",
        "pairAssets",
        "pools",
        "referenceBandBps",
        "deepPoolId",
        "thinPoolId",
        "depthRatio",
        "pattern",
        "restingGap",
        "evidence"
      ]
    },
    "BandSolve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "selected",
            "no-profitable-size",
            "incomplete-evidence"
          ]
        },
        "optimality": {
          "enum": [
            "best-found",
            "grid-complete",
            "certified"
          ]
        },
        "sizeRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "grossRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignedRaw"
            },
            {
              "type": "null"
            }
          ]
        },
        "lenderFeeRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "networkCostRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "netRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignedRaw"
            },
            {
              "type": "null"
            }
          ]
        },
        "evaluations": {
          "$ref": "#/$defs/Count"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        }
      },
      "required": [
        "status",
        "optimality",
        "sizeRaw",
        "grossRaw",
        "lenderFeeRaw",
        "networkCostRaw",
        "netRaw",
        "evaluations",
        "reason"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "networkCostRaw": {
                "type": "null"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "netRaw": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "type": "object"
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "selected"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "sizeRaw": {
                "$ref": "#/$defs/Raw"
              },
              "grossRaw": {
                "$ref": "#/$defs/SignedRaw"
              }
            },
            "type": "object"
          }
        }
      ]
    },
    "BandRow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triggerPoolId": {
          "$ref": "#/$defs/Id"
        },
        "triggerDirection": {
          "$ref": "#/$defs/TriggerDirection"
        },
        "triggerAsset": {
          "$ref": "#/$defs/Asset"
        },
        "triggerRaw": {
          "$ref": "#/$defs/Raw"
        },
        "projectedStateDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "gapAfterBps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Ratio"
            },
            {
              "type": "null"
            }
          ]
        },
        "solve": {
          "$ref": "#/$defs/BandSolve"
        },
        "exitPoolId": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "triggerPoolId",
        "triggerDirection",
        "triggerAsset",
        "triggerRaw",
        "projectedStateDigest",
        "gapAfterBps",
        "solve",
        "exitPoolId"
      ]
    },
    "SMin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triggerPoolId": {
          "$ref": "#/$defs/Id"
        },
        "triggerDirection": {
          "$ref": "#/$defs/TriggerDirection"
        },
        "minimumTriggerRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "bracketLowRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "bracketHighRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "enum": [
            "bisection",
            "grid-first-positive",
            "none-positive-in-grid",
            "incomplete-evidence"
          ]
        },
        "evaluations": {
          "$ref": "#/$defs/Count"
        },
        "reason": {
          "$ref": "#/$defs/Reason"
        }
      },
      "required": [
        "triggerPoolId",
        "triggerDirection",
        "minimumTriggerRaw",
        "bracketLowRaw",
        "bracketHighRaw",
        "method",
        "evaluations",
        "reason"
      ]
    },
    "EntryBand": {
      "allOf": [
        {
          "$ref": "#/$defs/Header"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "schemaVersion": true,
        "runId": true,
        "recordType": {
          "const": "entry-band"
        },
        "counterfactual": {
          "const": true
        },
        "stateDigest": {
          "$ref": "#/$defs/Hash"
        },
        "policyHash": {
          "$ref": "#/$defs/Hash"
        },
        "patternRef": {
          "$ref": "#/$defs/Hash"
        },
        "lender": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "$ref": "#/$defs/Id"
            },
            "feePips": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "capacityRaw": {
              "$ref": "#/$defs/Raw"
            },
            "callbackAdmitted": {
              "type": "boolean"
            }
          },
          "required": [
            "provider",
            "feePips",
            "capacityRaw",
            "callbackAdmitted"
          ]
        },
        "costEvidenceRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BandRow"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "sMin": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SMin"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "validThroughHeight": {
          "$ref": "#/$defs/Raw"
        },
        "incompleteRows": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "recordType",
        "counterfactual",
        "stateDigest",
        "policyHash",
        "patternRef",
        "lender",
        "costEvidenceRef",
        "rows",
        "sMin",
        "validThroughHeight",
        "incompleteRows"
      ]
    },
    "TriggerObservation": {
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "decision": {
                "const": "SOLVE"
              },
              "bandRef": {
                "type": "null"
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "schemaVersion": true,
        "runId": true,
        "recordType": {
          "const": "trigger-observation"
        },
        "state": {
          "$ref": "#/$defs/StateIdentity"
        },
        "transactionId": {
          "$ref": "#/$defs/Id"
        },
        "logIndex": {
          "$ref": "#/$defs/Count"
        },
        "poolId": {
          "$ref": "#/$defs/Id"
        },
        "direction": {
          "$ref": "#/$defs/TriggerDirection"
        },
        "amountInRaw": {
          "$ref": "#/$defs/Raw"
        },
        "bandRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "sMinRaw": {
          "anyOf": [
            {
              "$ref": "#/$defs/Raw"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAtNs": {
          "$ref": "#/$defs/Raw"
        },
        "inclusionToObservationMs": {
          "anyOf": [
            {
              "$ref": "#/$defs/Count"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision": {
          "enum": [
            "SOLVE",
            "DEFERRED_BELOW_SMIN",
            "DEFERRED_NO_BAND",
            "STALE_BAND",
            "REORGED",
            "OUTSIDE_WATCH",
            "QUEUED"
          ]
        },
        "solverRunId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 512
        }
      },
      "required": [
        "recordType",
        "state",
        "transactionId",
        "logIndex",
        "poolId",
        "direction",
        "amountInRaw",
        "bandRef",
        "sMinRaw",
        "observedAtNs",
        "inclusionToObservationMs",
        "decision",
        "solverRunId",
        "reason"
      ],
      "if": {
        "properties": {
          "decision": {
            "const": "SOLVE"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "solverRunId": {
            "$ref": "#/$defs/Id"
          }
        },
        "type": "object"
      }
    },
    "Leg": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branchId": {
          "$ref": "#/$defs/Id"
        },
        "legIndex": {
          "$ref": "#/$defs/Count"
        },
        "poolId": {
          "$ref": "#/$defs/Id"
        },
        "inputRaw": {
          "$ref": "#/$defs/Raw"
        },
        "outputRaw": {
          "$ref": "#/$defs/Raw"
        },
        "spotOutputRaw": {
          "$ref": "#/$defs/Raw"
        },
        "feeRaw": {
          "$ref": "#/$defs/Raw"
        },
        "impactBps": {
          "$ref": "#/$defs/Ratio"
        },
        "isDislocatedLeg": {
          "type": "boolean"
        }
      },
      "required": [
        "branchId",
        "legIndex",
        "poolId",
        "inputRaw",
        "outputRaw",
        "spotOutputRaw",
        "feeRaw",
        "impactBps",
        "isDislocatedLeg"
      ]
    },
    "LegAttribution": {
      "allOf": [
        {
          "$ref": "#/$defs/Header"
        }
      ],
      "type": "object",
      "unevaluatedProperties": false,
      "properties": {
        "schemaVersion": true,
        "runId": true,
        "recordType": {
          "const": "leg-attribution"
        },
        "planHash": {
          "$ref": "#/$defs/Hash"
        },
        "stateDigest": {
          "$ref": "#/$defs/Hash"
        },
        "legs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Leg"
          },
          "minItems": 2,
          "maxItems": 64
        },
        "dominantImpactLeg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branchId": {
              "$ref": "#/$defs/Id"
            },
            "legIndex": {
              "$ref": "#/$defs/Count"
            }
          },
          "required": [
            "branchId",
            "legIndex"
          ]
        },
        "hopDecision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "enum": [
                "KEEP",
                "SPLIT_EXIT_LEG",
                "ADD_HUB_HOP",
                "REDUCE_SIZE",
                "REJECT"
              ]
            },
            "alternativesEvaluated": {
              "$ref": "#/$defs/Count"
            },
            "netGainRaw": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SignedRaw"
                },
                {
                  "type": "null"
                }
              ]
            },
            "addedCostRaw": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Raw"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "action",
            "alternativesEvaluated",
            "netGainRaw",
            "addedCostRaw",
            "reason"
          ],
          "if": {
            "properties": {
              "action": {
                "enum": [
                  "SPLIT_EXIT_LEG",
                  "ADD_HUB_HOP"
                ]
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "alternativesEvaluated": {
                "type": "integer",
                "minimum": 1
              },
              "netGainRaw": {
                "$ref": "#/$defs/SignedRaw"
              },
              "addedCostRaw": {
                "$ref": "#/$defs/Raw"
              }
            },
            "type": "object"
          }
        }
      },
      "required": [
        "recordType",
        "planHash",
        "stateDigest",
        "legs",
        "dominantImpactLeg",
        "hopDecision"
      ]
    },
    "Artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "enum": [
            "discovery",
            "canonical-state",
            "counterfactual-model",
            "native-quote",
            "native-simulation",
            "receipt",
            "configuration",
            "policy",
            "plan",
            "ledger",
            "report",
            "solver",
            "readiness",
            "pattern",
            "band",
            "trigger",
            "survival",
            "attribution",
            "raw-pool",
            "unsigned-payload",
            "native-result",
            "search-domain",
            "stage-event",
            "native-receipt",
            "legacy-unparsed",
            "execution-candidate"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/Hash"
        },
        "bytes": {
          "$ref": "#/$defs/Count"
        },
        "parse": {
          "enum": [
            "ok",
            "empty",
            "invalid-json",
            "schema-invalid"
          ]
        },
        "reusedFrom": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runId": {
                  "$ref": "#/$defs/Id"
                },
                "path": {
                  "$ref": "#/$defs/Id"
                }
              },
              "required": [
                "runId",
                "path"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "declaredReuse": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "kind",
        "sha256",
        "bytes",
        "parse",
        "reusedFrom",
        "declaredReuse"
      ],
