{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity",
  "type": "object",
  "required": ["id", "chainId", "channel", "strategy", "expiresAt", "plans"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "chainId": { "type": "integer", "minimum": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "strategy": { "type": "string", "minLength": 1 },
    "expiresAt": { "type": "string", "format": "date-time" },
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "priceImpactBps", "quotedNetProfitUsd", "legs", "transaction"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "borrowTierUsd": { "type": "number", "minimum": 0 },
          "priceImpactBps": { "type": "number", "minimum": 0 },
          "quotedNetProfitUsd": { "type": "number" },
          "sourceBlock": { "type": ["string", "integer"], "minimum": 0 },
          "quoteBlock": { "type": ["string", "integer"], "minimum": 0 },
          "capability": { "enum": ["aave-v3-liquidation", "morpho-blue-liquidation", "uniswap-v4-arbitrage", "dex-pair-arbitrage"] },
          "profitTokenUsd": { "type": "number", "exclusiveMinimum": 0 },
          "profitTokenDecimals": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    }
  }
}
