{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Liquidity snapshot provenance v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "sourceId", "cursor", "observedAtMs", "complete", "poolIds", "stateDigest"],
  "properties": {
    "schemaVersion": { "const": "3.0" },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "cursor": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20 },
    "observedAtMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "complete": { "type": "boolean" },
    "stateDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "poolIds": { "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": { "type": "string", "maxLength": 256, "pattern": "^(arbitrum:(42161|421614)|sui:(mainnet|testnet|localnet)):" } },
    "identity": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["chain", "network", "height", "blockHash"], "properties": {
          "chain": { "const": "arbitrum" }, "network": { "enum": ["42161", "421614"] }, "height": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20 }, "blockHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
        } },
        { "type": "object", "additionalProperties": false, "required": ["chain", "network", "height", "checkpointDigest"], "properties": {
          "chain": { "const": "sui" }, "network": { "enum": ["mainnet", "testnet", "localnet"] }, "height": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20 }, "checkpointDigest": { "type": "string", "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$" }
        } }
      ]
    }
  },
  "$comment": "Runtime additionally enforces u64 upper bounds and pool IDs matching the selected chain/network. This schema represents snapshot provenance, not a proof of protocol state completeness."
}
