{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Speculative V2 replay event",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/poolUpsert" },
    { "$ref": "#/$defs/speculateV2" }
  ],
  "$defs": {
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "uint": { "type": "string", "pattern": "^[0-9]+$" },
    "snapshot": {
      "type": "object",
      "required": ["blockNumber", "blockHash", "observedAtMs"],
      "properties": {
        "blockNumber": { "type": "integer", "minimum": 0 },
        "blockHash": { "type": "string", "pattern": "^0x[0-9a-fA-F]+$" },
        "observedAtMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "poolUpsert": {
      "type": "object",
      "required": ["eventType", "pool"],
      "properties": {
        "eventType": { "const": "poolUpsert" },
        "pool": {
          "type": "object",
          "required": ["id", "venue", "venueId", "token0", "token1", "snapshot", "state"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "venue": { "const": "uniswap-v2" },
            "venueId": { "type": "integer", "minimum": 0 },
            "token0": { "$ref": "#/$defs/address" },
            "token1": { "$ref": "#/$defs/address" },
            "snapshot": { "$ref": "#/$defs/snapshot" },
            "state": {
              "type": "object",
              "required": ["kind", "reserve0", "reserve1", "feeBps"],
              "properties": {
                "kind": { "const": "v2" },
                "reserve0": { "$ref": "#/$defs/uint" },
                "reserve1": { "$ref": "#/$defs/uint" },
                "feeBps": { "type": "integer", "minimum": 0, "maximum": 9999 }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "speculateV2": {
      "type": "object",
      "required": ["eventType", "targetPoolId", "counterPoolId", "flashToken", "targetAmountIn", "flashLoanFeeBps", "fixedCost", "nowMs"],
      "properties": {
        "eventType": { "const": "speculateV2" },
        "targetPoolId": { "type": "string", "minLength": 1 },
        "counterPoolId": { "type": "string", "minLength": 1 },
        "flashToken": { "$ref": "#/$defs/address" },
        "targetAmountIn": { "$ref": "#/$defs/uint" },
        "flashLoanFeeBps": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "fixedCost": { "$ref": "#/$defs/uint" },
        "nowMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
